{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd .. && npm ci && cd web && npm ci",
  "buildCommand": "next build",
  "functions": {
    "app/api/run/route.ts": { "maxDuration": 60 },
    "app/mcp/route.ts": { "maxDuration": 60 },
    "app/ucp/v1/checkout-sessions/[id]/complete/route.ts": { "maxDuration": 60 },
    "app/api/commerce/run/route.ts": { "maxDuration": 120 },
    "app/acp/checkout_sessions/[id]/complete/route.ts": { "maxDuration": 60 },
    "app/r/[ns]/paypal/return/route.ts": { "maxDuration": 60 }
  }
}
