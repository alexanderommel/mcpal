# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live. Live disables the sandbox_card auto-approval path.
PAYPAL_ENV=sandbox
# Webhook ID from the app's webhook settings (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Optional: sandbox accounts used by tests and pay_out examples
PAYPAL_BUYER_EMAIL=
PAYPAL_BUSINESS_EMAIL=
# Optional: load PayPal credentials from another env file (default ~/paypal-hackathon-research/.env.paypal-sandbox)
# MCPAL_PAYPAL_ENV_FILE=

# MCPal runtime
# Where the SQLite ledger and the decision log live (default ./.mcpal)
MCPAL_DATA_DIR=.mcpal
# Policy file (default ./mcpal.policy.json)
MCPAL_POLICY_FILE=mcpal.policy.json
# Public base URL of the HTTP server, used to build human approval links
MCPAL_PUBLIC_URL=http://localhost:8787
MCPAL_HTTP_PORT=8787
# Sandbox test card used by method card_on_file (sandbox only; PayPal sandbox test Visa)
MCPAL_SANDBOX_CARD=4012000077777777
# Merchant key for the approval page and POST /quotes (quotes are disabled without it)
MCPAL_APPROVER_TOKEN=
# Optional merchant price list loaded at start: [{"quoteRef":"order-42","amount":"42.50","currency":"USD"}]
MCPAL_QUOTES_FILE=

# AI keys (bench only)
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
